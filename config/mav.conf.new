# Proposed mavlink-router config (replaces mav.conf once 99-pixhawk.rules is installed).
# One serial owner, three consumers. All UDP endpoints are localhost-only.
# Comments must sit on their own lines: mavlink-router does not strip trailing "# ..."
# from values, so "TcpServerPort = 5760  # ..." fails to parse.

[General]
# QGC over Tailscale: tcp:highfieldboat.tailcacf9.ts.net:5760
TcpServerPort = 5760
ReportStats = false
# Router tlogs, useful for post-run analysis. deploy/install.sh creates the dir.
Log = /home/boat/mavlogs
LogMode = while-armed

[UartEndpoint pixhawk]
Device = /dev/pixhawk
Baud = 115200

# Router sends to this address; iArduRoverBridge uses udpin 0.0.0.0 14551
[UdpEndpoint moos]
Mode = Normal
Address = 127.0.0.1
Port = 14551

# Status web GUI / ap_inventory.py --conn udpin:127.0.0.1:14552
[UdpEndpoint gui]
Mode = Normal
Address = 127.0.0.1
Port = 14552
