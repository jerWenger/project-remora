# boat-sitl.parm -- HighFieldBoat overlay for ArduRover SITL (motorboat-skid).
#
# Loaded LAST by sim/run_sitl.sh, after the stock SITL defaults sim_vehicle.py
# uses for motorboat-skid:
#   Tools/autotest/default_params/rover.parm      (sim sensors, SERVO1/3 1000..2000, BATT_MONITOR 4)
#   Tools/autotest/default_params/motorboat.parm  (FRAME_CLASS 2, waves/wind/tide)
#   Tools/autotest/default_params/rover-skid.parm (SERVO1_FUNCTION 73, SERVO3_FUNCTION 74)
#
# These are *defaults*: a value already saved in sim/run/I<n>/eeprom.bin wins.
# After editing this file run `sim/run_sitl.sh --wipe` so every value applies.
#
# Source of the behavioral values: params/2026-10-04.parm (real boat dump,
# ArduRover 4.7.0). Hardware-specific params are deliberately NOT copied:
# INS_*_ID, COMPASS_DEV_ID*, COMPASS_* offsets/enable, CAN_*, GPS1_TYPE=9, BRD_*,
# SERIAL* (except the sim's own ports below), BATT_MONITOR, BARO*_DEVID, any
# calibration offsets, EK3_SRC* (the real boat has no compass yet).
#
# Names the SITL build does not know are skipped (quietly, in practice), so
# params that exist on 4.7.0 but not in the local SITL build are harmless.

# ---------------------------------------------------------------------------
# Frame
# ---------------------------------------------------------------------------
FRAME_CLASS 2           # boat (same as real)
FRAME_TYPE 0

# ---------------------------------------------------------------------------
# Outputs -- INTENTIONALLY DIFFERENT FROM THE BOAT
#
# The SITL motorboat-skid physics (libraries/SITL/SIM_Sailboat.cpp,
# MOTORLEFT_SERVO_CH 0 / MOTORRIGHT_SERVO_CH 2) reads the LEFT thruster from
# servo output 1 and the RIGHT thruster from servo output 3, and normalises
# PWM as 1000 = full reverse, 1500 = stop, 2000 = full forward.
#
# The real boat drives the VCB from SERVO9 (AUX1, ThrottleRight=74) and
# SERVO10 (AUX2, ThrottleLeft=73), 990/990/1200, forward-only.
#
# Forward-only is reproduced here with MIN = TRIM = 1500: ArduPilot maps
# negative thrust onto the (empty) MIN..TRIM band, so the sim motors can
# never reverse, just as with the real MIN = TRIM = 990. Disarmed
# (MOT_SAFE_DISARM 0) the outputs sit at TRIM = stop, like the real boat.
# The VCB's 20 % clamp is NOT modelled -- see sim/README.md.
# ---------------------------------------------------------------------------
SERVO1_FUNCTION 73      # ThrottleLeft  (real boat: SERVO10)
SERVO1_MIN 1500
SERVO1_TRIM 1500
SERVO1_MAX 2000
SERVO1_REVERSED 0
SERVO3_FUNCTION 74      # ThrottleRight (real boat: SERVO9)
SERVO3_MIN 1500
SERVO3_TRIM 1500
SERVO3_MAX 2000
SERVO3_REVERSED 0
SERVO9_FUNCTION 0       # nothing on AUX in sim (the physics ignores it)
SERVO10_FUNCTION 0

# ---------------------------------------------------------------------------
# Motors (from real dump)
# ---------------------------------------------------------------------------
MOT_SAFE_DISARM 0
MOT_SLEWRATE 100
MOT_STR_THR_MIX 0.5
MOT_THR_MAX 100         # set 20 to roughly emulate the VCB cap (see README)
MOT_THR_MIN 0
MOT_THST_ASYM 1
MOT_THST_EXPO 0

# ---------------------------------------------------------------------------
# Speed / cruise (from real dump; these are still the ArduPilot defaults on
# the boat -- not learned). The sim hull settles at much higher speed per
# unit throttle than the RHIB will, so the speed PID does more work here.
# ---------------------------------------------------------------------------
CRUISE_SPEED 2
CRUISE_THROTTLE 50
SPEED_MAX 0

# ---------------------------------------------------------------------------
# Attitude / speed / steering controllers (ATC_*, from real dump)
# rover.parm/rover-skid.parm set ATC_SPEED_P 0.1 and ATC_STR_RAT_FF; these
# restore the boat's values.
# ---------------------------------------------------------------------------
ATC_ACCEL_MAX 1
ATC_BRAKE 1
ATC_DECEL_MAX 0
ATC_STOP_SPEED 0.1
ATC_TURN_MAX_G 0.6
ATC_SPEED_P 0.2
ATC_SPEED_I 0.2
ATC_SPEED_D 0
ATC_SPEED_FF 0
ATC_SPEED_IMAX 1
ATC_SPEED_FLTE 10
ATC_STR_ACC_MAX 120
ATC_STR_ANG_P 2
ATC_STR_DEC_MAX 0
ATC_STR_RAT_MAX 120
ATC_STR_RAT_P 0.2
ATC_STR_RAT_I 0.2
ATC_STR_RAT_D 0
ATC_STR_RAT_FF 0.2
ATC_STR_RAT_IMAX 1
ATC_STR_RAT_FLTE 10

# ---------------------------------------------------------------------------
# Position controller (PSC_*, from real dump) -- used by Loiter/Guided/Dock
# ---------------------------------------------------------------------------
PSC_POS_P 0.2
PSC_VEL_P 1
PSC_VEL_I 0
PSC_VEL_D 0
PSC_VEL_FF 0
PSC_VEL_IMAX 1

# ---------------------------------------------------------------------------
# Navigation (WP_*, TURN_RADIUS, LOIT_*, from real dump)
# TURN_RADIUS 0.9 is the ArduPilot default and is optimistic for a RHIB
# with forward-only thrusters; kept identical so behaviour matches the boat.
# ---------------------------------------------------------------------------
WP_SPEED 2
WP_RADIUS 2
WP_ACCEL 0
WP_JERK 0
WP_PIVOT_ANGLE 0
WP_PIVOT_DELAY 0
WP_PIVOT_RATE 60
TURN_RADIUS 0.9
LOIT_RADIUS 2
LOIT_TYPE 0
LOIT_SPEED_GAIN 0.5
RTL_SPEED 0
MIS_DONE_BEHAVE 1
GUID_OPTIONS 0

# ---------------------------------------------------------------------------
# Failsafes and fence (from real dump -- i.e. currently NOTHING stops the
# boat on a lost link). Kept identical so the sim fails the same way the
# boat would; flip them here to rehearse the planned config before the wet run.
# ---------------------------------------------------------------------------
FS_ACTION 2
FS_CRASH_CHECK 0
FS_EKF_ACTION 1
FS_EKF_THRESH 0.8
FS_GCS_ENABLE 0
FS_GCS_TIMEOUT 5
FS_OPTIONS 0
FS_THR_ENABLE 0
FS_THR_VALUE 910
FS_TIMEOUT 1.5
FENCE_ENABLE 0
FENCE_ACTION 1
FENCE_TYPE 6
FENCE_RADIUS 300
FENCE_MARGIN 2
FENCE_OPTIONS 0

# ---------------------------------------------------------------------------
# Arming (from real dump). ARMING_SKIPCHK is the 4.7.0 name (64 = skip RC check).
# The local master build (4.7.0-dev, 09c81414) still uses ARMING_CHECK and
# skips this line; SITL's simulated RC passes the RC check anyway.
# ---------------------------------------------------------------------------
ARMING_REQUIRE 1
ARMING_RUDDER 2
ARMING_SKIPCHK 64
ARMING_NEED_LOC 0
ARMING_ACCTHRESH 0.75
ARMING_MAGTHRESH 100
ARMING_OPTIONS 0

# ---------------------------------------------------------------------------
# Modes (from real dump): every switch position = Manual, switch on RC8.
# INITIAL_MODE 0 = Manual at boot.
# ---------------------------------------------------------------------------
INITIAL_MODE 0
MODE_CH 8
MODE1 0
MODE2 0
MODE3 0
MODE4 0
MODE5 0
MODE6 0

# ---------------------------------------------------------------------------
# RC (no radio needed in sim)
#
# SITL has a built-in simulated receiver: all channels default to 1500 us,
# so RC is "healthy" with no radio attached. Ways to move sticks without one:
#  * MAVLink RC_CHANNELS_OVERRIDE from source sysid == MAV_GCS_SYSID (255),
#    e.g. pymavlink:
#      m.mav.rc_channels_override_send(1, 1, 1500, 0, 1700, 0, 0, 0, 0, 0)
#    Overrides time out after RC_OVERRIDE_TIME seconds; resend at >= 1 Hz.
#  * UDP to the SITL RC port 5501+10*I: 8 or 16 little-endian uint16 PWM
#    values per packet (what MAVProxy's rc command does).
#  * SIM_RC_FAIL 1 (no pulses) or 2 (neutral, throttle 950) to rehearse a
#    radio failsafe.
# RC_OPTIONS / RC_OVERRIDE_TIME / RCn ranges copied from the real dump.
# ---------------------------------------------------------------------------
MAV_GCS_SYSID 255
RC_OPTIONS 32
RC_OVERRIDE_TIME 3
RC_FS_TIMEOUT 1
RC1_MIN 1000
RC1_TRIM 1500
RC1_MAX 2000
RC1_DZ 30
RC3_MIN 1000
RC3_TRIM 1500
RC3_MAX 2000
RC3_DZ 30
SIM_RC_FAIL 0

# ---------------------------------------------------------------------------
# Logging (from real dump). Dataflash logs go to sim/run/I<n>/logs/.
# ---------------------------------------------------------------------------
LOG_BITMASK 65535
LOG_DISARMED 0
LOG_BACKEND_TYPE 1
LOG_FILE_DSRMROT 0

# ---------------------------------------------------------------------------
# Sim telemetry ports (NOT copied from the boat -- the boat's SERIALn are
# hardware UARTs). run_sitl.sh maps:
#   SERIAL0 = TCP 5760 (+10*I)         MAV1_*
#   SERIAL1 = UDP out 14551 (+10*I)    MAV2_*  iArduRoverBridge
#   SERIAL2 = UDP out 14552 (+10*I)    MAV3_*  dashboard
# Protocol 2 = MAVLink2.
#
# On the boat all three consumers share one Pixhawk link through
# mavlink-router, so a stream rate requested by any of them applies to all.
# In SITL each port is its own MAVLink channel with its own rates, so give
# the UDP ports useful default rates (Hz) instead of relying on QGC asking.
# ---------------------------------------------------------------------------
SERIAL0_PROTOCOL 2
SERIAL1_PROTOCOL 2
SERIAL2_PROTOCOL 2
MAV2_RAW_SENS 2
MAV2_EXT_STAT 2
MAV2_RC_CHAN 2
MAV2_RAW_CTRL 2
MAV2_POSITION 5
MAV2_EXTRA1 5
MAV2_EXTRA2 5
MAV2_EXTRA3 2
MAV2_PARAMS 10
MAV3_RAW_SENS 2
MAV3_EXT_STAT 2
MAV3_RC_CHAN 2
MAV3_RAW_CTRL 2
MAV3_POSITION 5
MAV3_EXTRA1 5
MAV3_EXTRA2 5
MAV3_EXTRA3 2
MAV3_PARAMS 10
