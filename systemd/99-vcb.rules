# Stable name for the VCB telemetry port: /dev/vcb
# The VCB's CSV goes out a UART (the flash dump has no USB-CDC descriptor strings), read
# through the STLINK-V3 debug probe's virtual COM port (interface 01). Seen on the Jetson
# 2026-10-04 as /dev/serial/by-id/usb-STMicroelectronics_STLINK-V3_003E001C3234511037333934-if01.
# Pinned by the probe's serial so another ST device can't take the name. If the probe is
# swapped, read the new serial from `ls -l /dev/serial/by-id/` and replace it here.
# ID_MM_DEVICE_IGNORE keeps ModemManager from probing the port with AT commands.
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{serial}=="003E001C3234511037333934", SYMLINK+="vcb", GROUP="dialout", MODE="0660", ENV{ID_MM_DEVICE_IGNORE}="1", TAG+="systemd"
