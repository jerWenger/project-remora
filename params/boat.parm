# HighFieldBoat desired-state parameters (Pixhawk 6X, ArduRover 4.7.0).
#
# Only settings that are DECIDED live here, uncommented. Everything else on the
# vehicle stays as dumped in params/<date>.parm. Apply with:
#   tools/ap_apply.py params/boat.parm --dry-run
#   tools/ap_apply.py params/boat.parm
# Format: NAME,value  ('#' = comment). Proposals are commented out with a reason;
# enable them one at a time after the physical check named next to them.
# All names checked against params/2026-10-04.parm (the real dump) unless noted.

# --- GPS: Unicore UM982 (ArduSimple simpleRTK3B) on the GPS2 connector = SERIAL4 ----
# Verified 2026-10-18 with tools/gps_probe.py --probe --port 4: the receiver sends
# $GNGGA/$GNRMC/$GNHDT at 115200 on SERIAL4. Do NOT put it on TELEM1: its stream keeps
# the Pixhawk 6X in the bootloader at power-up (board enumerates as PX4_BL, never boots).
# GPS slot N reads only the Nth SERIALn with protocol 5, so the empty GPS1 connector
# (SERIAL3) must be disabled or GPS1 listens there and never sees SERIAL4. Reboot after.
SERIAL3_PROTOCOL,-1
SERIAL4_PROTOCOL,5
# 25 = UnicoreMovingBaselineNMEA with auto-config: ArduPilot configures the UM982 itself
# (it moves the receiver to 230400 and enables #UNIHEADINGA, which is where yaw comes from).
# Type 24 + AUTO_CONFIG 0 gave position but yaw=65535 (2026-10-18). Probe after the change:
# receiver at 230400, $GNHDT,4.47,T populated, so SERIAL4_BAUD follows it.
GPS1_TYPE,25
GPS_AUTO_CONFIG,1
SERIAL4_BAUD,230
# The CAN puck (was GPS1_TYPE,9) is unplugged.
GPS2_TYPE,0
# TELEM1 back to MAVLink after the guide set it to GPS.
SERIAL1_PROTOCOL,2
SERIAL1_BAUD,57
# EK3_SRC1_YAW,2 (GPS) was set by the guide and is what we want with a dual-antenna receiver.
# Moving-baseline yaw is REJECTED until ArduPilot knows the antenna spacing: it compares the
# baseline the receiver reports against this offset (~20 % tolerance). MB_TYPE 0 derives it
# from GPS2_POS - GPS1_POS (both zero here) => length 0 => yaw=65535 (2026-10-18).
# MB_TYPE 1 uses GPS1_MB_OFS_*, which only appear after MB_TYPE is 1 and a reboot.
GPS1_MB_TYPE,1
# Position of the 2nd (slave, ANT2) antenna relative to the 1st (master, ANT1), metres,
# body frame: X forward, Y right, Z down. MEASURE centre to centre, then uncomment.
# If the heading comes out 180 deg off, ANT1/ANT2 are swapped: swap the cables.
#GPS1_MB_OFS_X,0.00
#GPS1_MB_OFS_Y,0.00
#GPS1_MB_OFS_Z,0.00

# --- Compass -------------------------------------------------------------
# NOTE 2026-10-18: the DroneCAN puck (compass 1 below) is unplugged while the UM982 is
# in. With GPS yaw working the compass matters less; revisit COMPASS_USE/ORIENT then.
# Without a compass the EKF had no heading and sat in CONST_POS_MODE.
# COMPASS_ENABLE needs a reboot (ap_apply says so). After that: large-vehicle mag cal.
COMPASS_ENABLE,1
# Compass 1 = DroneCAN magnetometer in the GPS puck (DEV_ID 97539, node 125).
COMPASS_USE,1
# Compass 2 = Pixhawk 6X internal BMM150, sits next to the motor wiring: don't fuse it.
COMPASS_USE2,0
# 0 = no rotation. VERIFY the arrow on the GPS puck points at the bow; if not, fix the
# mount or set the matching ROTATION_* value here.
COMPASS_ORIENT,0

# --- Battery -------------------------------------------------------------
# Battery 1 = the I2C power module on POWER1, which measures the 24 V electronics rail
# (24.2 V, 2026-10-04), NOT the 48 V pack. It only reads when the electronics box is
# powered; with the box off it reads BAD and blocks arming, which is correct.
# The pack is read by the Jetson from the LiTime BMS (scripts/battery_litime.py); pack
# failsafes need it injected as a second battery (BATT2_MONITOR,29 via Lua) later.
# No current/capacity meaning on this rail: capacity 0 hides the bogus "% remaining".
# Reboot needed after BATT_MONITOR changes.
BATT_MONITOR,21
BATT_CAPACITY,0

# --- Thruster outputs (AUX1/AUX2 -> VCB) ---------------------------------
# Dead-bus check 2026-10-04 (tools/vcb_bench_check.py): AUX1 reaches VCB ch1, which the
# VCB firmware drives as the RIGHT motor, and AUX2 reaches ch2 (LEFT). So AUX1 must be
# ThrottleRight (74) and AUX2 ThrottleLeft (73). Confirm on the first live spin that the
# right prop turns for a right-side command; if not, the VCB's own labels are wrong.
SERVO9_FUNCTION,74
SERVO10_FUNCTION,73
# VCB applies (us - 1000) permille and clamps at 1200 us = 200 o/oo (20 %), measured.
# MAX 1200 maps ArduPilot's full throttle onto that band. MIN = TRIM keeps the outputs
# forward-only and is what they hold when disarmed. The VCB reads ~3-4 us high, so 1000
# out showed as 3 o/oo; 990 out reads 993-994 us = 0 o/oo and is still flagged valid
# (990 and 995 both tested), giving a true "stopped" with margin against jitter.
SERVO9_MIN,990
SERVO9_TRIM,990
SERVO9_MAX,1200
SERVO10_MIN,990
SERVO10_TRIM,990
SERVO10_MAX,1200

# ==========================================================================
# PROPOSALS -- commented out on purpose. Enable deliberately, one group at a time.
# ==========================================================================

# --- Leftover outputs on MAIN1/MAIN3 --------------------------------------
# GroundSteering (26) and Throttle (70) idle at 1500 us. Disable ONLY after confirming
# nothing is wired to MAIN1/MAIN3 (if the VCB were there it would see 20 % thrust).
# Takes effect live, no reboot.
#SERVO1_FUNCTION,0
#SERVO3_FUNCTION,0

# --- Failsafes ---------------------------------------------------------------
# GCS failsafe: no GCS heartbeat for FS_TIMEOUT s (1.5) -> FS_ACTION (2 = Hold).
# Needs a GCS (QGC / MOOS bridge) sending heartbeats whenever the boat is armed.
#FS_GCS_ENABLE,1
# Optional: give a lossy tailnet more slack before Hold (dump has 1.5 s).
#FS_TIMEOUT,5

# Geofence: circle around home (FENCE_TYPE bit1 = 2); add bit2 (polygon, =6 total) once a
# polygon is uploaded. FENCE_ACTION (Rover): 1 = RTL or Hold, 2 = Hold (safer while RTL is untuned).
# Pick FENCE_RADIUS for the test area (m).
#FENCE_ENABLE,1
#FENCE_TYPE,2
#FENCE_ACTION,2
#FENCE_RADIUS,150
#FENCE_MARGIN,5

# --- ELRS receiver (CRSF) on TELEM3 = SERIAL5 -----------------------------------
# 23 = RCIN. ArduPilot ignores SERIAL5_BAUD for RCIN: the RC layer sets the UART itself
# (auto-scans 115200/100000/416666/2000000, CRSF bootstraps at 416666). ELRS receivers
# default to 420000; RC_OPTIONS bit 13 (8192) "Use 420kbaud for ELRS" makes ArduPilot
# bootstrap at 420000. The dump has RC_OPTIONS=32 (bit 5), so 32+8192 = 8224.
# Also bit 9 (512, suppress CRSF mode/rate text for ELRS) is common: 8736.
# RSSI_TYPE 3 = RSSI/LQ from the receiver protocol. Reboot needed for SERIAL5_*.
#SERIAL5_PROTOCOL,23
#RC_OPTIONS,8224
#RSSI_TYPE,3
# Then: RC failsafe once the receiver is bound and tested (FS_THR_VALUE is 910 us).
#FS_THR_ENABLE,1

# --- Flight modes on RC channel 8 (MODE_CH,8 already set) -------------------------
# Rover mode numbers: 0 Manual, 4 Hold, 15 Guided, 10 Auto, 11 RTL.
# 3-position switch: low = Manual, mid = Hold, high = Guided (MOOS via iArduRoverBridge).
# PWM bands: MODE1 <1231, MODE2 1231-1360, MODE3 1361-1490, MODE4 1491-1620,
# MODE5 1621-1749, MODE6 >1749 -> a 3-pos switch at ~1000/1500/2000 hits 1, 4, 6.
#MODE1,0
#MODE2,0
#MODE3,4
#MODE4,4
#MODE5,15
#MODE6,15
