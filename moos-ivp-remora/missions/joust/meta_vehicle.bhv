//-------------------------------------------------------------
// FILE: meta_vehicle.bhv  (nsplug template)
// NAME: Jeremy Wenger
// Joust: run one leg back and forth (BHV_LegRun) while another vessel
// crosses it, and avoid that vessel by the COLREGS. Modelled on the
// pavlab ufld_joust mission, with one leg per vehicle and no joust
// manager. The other vessel is a simulated skiff (launch.sh --sim) or a
// phone on the real skiff (shoreside iContactUDP). Coordinates are metres
// from the origin in ../remora/plugs/shared/plug_origin_warp.moos.
// The boat also returns by itself when the bridge reports BATTERY_OK=false.
//-------------------------------------------------------------

initialize   DEPLOY = false
initialize   RETURN = false
initialize   STATION_KEEP = false
initialize   AVOID = $(AVOID)

set MODE = ACTIVE {
  DEPLOY = true
} INACTIVE

set MODE = STATION-KEEPING {
  MODE = ACTIVE
  STATION_KEEP = true
}

set MODE = RETURNING {
  MODE = ACTIVE
  STATION_KEEP = false
  (RETURN = true) or (BATTERY_OK = false)
} TRANSITING

//----------------------------------------------
Behavior = BHV_LegRun
{
  name       = legrun
  pwt        = 100
  condition  = MODE==TRANSITING
  perpetual  = true
  updates    = LR_UPDATE

             vx1 = $(VX1)
             vx2 = $(VX2)

       turn1_dir = port
       turn2_dir = port
       turn1_rad = $(TURN_RAD)
       turn2_rad = $(TURN_RAD)
      turn1_bias = 0
      turn2_bias = 0
     turn_pt_gap = 20

           speed = $(SPEED)
        patience = 85
  capture_radius = 6.0
    capture_line = true
     slip_radius = 12.0

    visual_hints = turn_vertex_size   = 4
    visual_hints = turn_vertex_color  = $(COLOR)
    visual_hints = nextpt_label_color = $(COLOR)
    visual_hints = legpt_label_color  = $(COLOR)
    visual_hints = turn_label_color   = $(COLOR)
}

#include plugs/plug_avd_colregs.bhv

//----------------------------------------------
Behavior = BHV_Waypoint
{
  name       = waypt_return
  pwt        = 100
  condition  = MODE==RETURNING
  perpetual  = true
  updates    = RETURN_UPDATE
  // Latch: a battery-triggered return stays a return even if the pack
  // voltage recovers once the load comes off.
  activeflag = RETURN = true
  endflag    = RETURN = false
  endflag    = STATION_KEEP = true

           speed = $(SPEED)
          radius = 4.0
     slip_radius = 10.0
          points = pts={$(RETURN_POS)}
}

#include plugs/bhvs/plug_stationkeep.bhv
#include plugs/bhvs/plug_opregion.bhv
#include plugs/bhvs/plug_waypt_placeholder.bhv
