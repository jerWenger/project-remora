//-------------------------------------------------------------
// FILE: meta_vehicle.bhv  (nsplug template)
// A survey pattern south of the MIT Sailing Pavilion dock, then return
// to the start point and station-keep. launch_vehicle.sh --pattern picks
// the pattern: box (a 40 m square, the default) or fig8 (a smooth
// figure 8 with no corners). The boat also returns by itself when the
// bridge reports BATTERY_OK=false (pack under --return_volts or
// --return_pct for 10 s; never posted where there is no BMS file). Coordinates are
// metres from the origin in plug_origin_warp.moos. The ArduPilot
// SITL home in ../../../sim/run_sitl.sh (42.3577, -71.0872) is at
// about x=20, y=-82 in this frame.
//-------------------------------------------------------------

initialize   DEPLOY = false
initialize   RETURN = false
initialize   STATION_KEEP = false

set MODE = ACTIVE {
  DEPLOY = true
} INACTIVE

set MODE = STATION-KEEPING {
  MODE = ACTIVE
  STATION_KEEP = true
}

set MODE = RETURNING {
  MODE = ACTIVE
  STATION_KEEP = false
  (RETURN = true) or (BATTERY_OK = false)
} SURVEYING

//----------------------------------------------
Behavior = BHV_Waypoint
{
  name       = waypt_survey
  pwt        = 100
  condition  = MODE==SURVEYING
  perpetual  = true
  updates    = SURVEY_UPDATE
  endflag    = RETURN = true

             speed = $(SPEED)
            radius = $(WPT_RADIUS)
       slip_radius = $(WPT_SLIP)
              lead = $(WPT_LEAD)
       lead_damper = 1
     lead_to_start = true
            points = $(SURVEY_PTS)
            repeat = $(SURVEY_REPEAT)

    visual_hints = nextpt_color=yellow, nextpt_vertex_size=8
    visual_hints = vertex_color=dodger_blue, edge_color=white
    visual_hints = vertex_size=5, edge_size=1
}

//----------------------------------------------
Behavior = BHV_Waypoint
{
  name       = waypt_return
  pwt        = 100
  condition  = MODE==RETURNING
  perpetual  = true
  updates    = RETURN_UPDATE
  // Latch: a battery-triggered return stays a return even if the pack
  // voltage recovers once the load comes off.
  activeflag = RETURN = true
  endflag    = RETURN = false
  endflag    = STATION_KEEP = true

           speed = $(SPEED)
          radius = 4.0
     slip_radius = 10.0
          points = pts={$(RETURN_POS)}
}

#include plugs/bhvs/plug_stationkeep.bhv
#include plugs/bhvs/plug_opregion.bhv
#include plugs/bhvs/plug_waypt_placeholder.bhv
