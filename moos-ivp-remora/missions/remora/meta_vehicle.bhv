//-------------------------------------------------------------
// FILE: meta_vehicle.bhv  (nsplug template)
// A short survey box south of the MIT Sailing Pavilion dock, then
// return to the start point and station-keep. Coordinates are
// metres from the origin in plug_origin_warp.moos. The ArduPilot
// SITL home in ../../../sim/run_sitl.sh (42.3577, -71.0872) is at
// about x=20, y=-82 in this frame.
//-------------------------------------------------------------

initialize   DEPLOY = false
initialize   RETURN = false
initialize   STATION_KEEP = false

set MODE = ACTIVE {
  DEPLOY = true
} INACTIVE

set MODE = STATION-KEEPING {
  MODE = ACTIVE
  STATION_KEEP = true
}

set MODE = RETURNING {
  MODE = ACTIVE
  STATION_KEEP = false
  RETURN = true
} SURVEYING

//----------------------------------------------
Behavior = BHV_Waypoint
{
  name       = waypt_survey
  pwt        = 100
  condition  = MODE==SURVEYING
  perpetual  = true
  updates    = SURVEY_UPDATE
  endflag    = RETURN = true

             speed = $(SPEED)
            radius = 5.0
       slip_radius = 12.0
              lead = 8
       lead_damper = 1
     lead_to_start = true
            points = pts={0,-60:40,-60:40,-100:0,-100}
            repeat = 0

    visual_hints = nextpt_color=yellow, nextpt_vertex_size=8
    visual_hints = vertex_color=dodger_blue, edge_color=white
    visual_hints = vertex_size=5, edge_size=1
}

//----------------------------------------------
Behavior = BHV_Waypoint
{
  name       = waypt_return
  pwt        = 100
  condition  = MODE==RETURNING
  perpetual  = true
  updates    = RETURN_UPDATE
  endflag    = RETURN = false
  endflag    = STATION_KEEP = true

           speed = $(SPEED)
          radius = 4.0
     slip_radius = 10.0
          points = pts={$(RETURN_POS)}
}

#include plugs/bhvs/plug_stationkeep.bhv
#include plugs/bhvs/plug_opregion.bhv
#include plugs/bhvs/plug_waypt_placeholder.bhv
