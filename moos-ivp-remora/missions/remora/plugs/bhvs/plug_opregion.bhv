//----------------------------------------------
// Operating region. box: the Charles River basin in front of the pavilion,
// same polygon as the pavlab missions. fig8: a rectangle around the pattern
// (launch_vehicle.sh --op_margin). Leaving the halt zone stops the helm; the
// save zone turns the boat back first. It is enforced only once the boat
// has been inside for a second (trigger_on_poly_entry, the default), so a
// DEPLOY at the dock outside the region does not trip it.
Behavior = BHV_OpRegionV24
{
  name      = opreg
  pwt       = 300
  condition = MODE==ACTIVE
  updates   = RECOVER_UPDATES

  core_poly = $(OPREGION)

  save_dist = 5
  halt_dist = 10

  visual_hints = edge_size = 1
  visual_hints = save_edge_color = gray30
  visual_hints = halt_edge_color = gray40
}
